---
/**
 * 页脚。can-web 那一份的形状，内容换成开发者中心的。
 *
 * 三列而不是四列：主站的页脚要放飞行员、管制员、文档、链接四组，这边真正属于
 * 本站的只有三个页面，硬凑成四列只会得到一列占位符。列的样式、分隔线、版权行
 * 和 Powered by 都和主站逐字一致，跨站走过来不会觉得换了个地方。
 */
import { getLocale, useTranslations } from "@/lib/i18n";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "dev");
const tf = useTranslations(locale, "footer");

const SITE = "https://airwaysn.org";

interface FooterLink {
  name: string;
  href: string;
  external?: boolean;
}

const columns: { title: string; items: FooterLink[] }[] = [
  {
    title: t("siteName"),
    items: [
      { name: t("nav.home"), href: "/" },
      { name: t("nav.apps"), href: "/apps" },
      { name: t("nav.docs"), href: "/docs" },
    ],
  },
  {
    title: tf("docs.title"),
    items: [
      { name: tf("docs.items.regulations"), href: `${SITE}/docs` },
      { name: tf("controllers.items.roster"), href: `${SITE}/roster` },
      {
        name: tf("pilots.items.onlineMap"),
        href: "https://radar.airwaysn.org",
      },
    ],
  },
  {
    title: tf("links.title"),
    items: [
      {
        name: tf("links.items.qqGroup"),
        href: "https://qm.qq.com/cgi-bin/qm/qr?k=Y11e185GOAgYhI6_M9lOLOvmz2YArvTG&jump_from=webapi&authKey=riivLLjWMo16LUdNtmZegWp/E4p8Uhuf2A63aYD1SZckDV+6A1AUAUJDOD8wsLn2",
        external: true,
      },
      {
        name: tf("links.items.discord"),
        href: "https://discord.gg/uWxEtNEVp9",
        external: true,
      },
      { name: tf("links.items.support"), href: `${SITE}/support` },
    ],
  },
];

const socials = [
  {
    name: "GitHub",
    href: "https://github.com/AirwaySN/",
    path: "M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z",
  },
  {
    name: "BiliBili",
    href: "https://space.bilibili.com/3546824224803315",
    path: "M7.172 2.757L10.414 6h3.171l3.243-3.242a1 1 0 0 1 1.415 1.415l-1.829 1.827L18.5 6A3.5 3.5 0 0 1 22 9.5v8a3.5 3.5 0 0 1-3.5 3.5h-13A3.5 3.5 0 0 1 2 17.5v-8A3.5 3.5 0 0 1 5.5 6h2.085L5.757 4.171a1 1 0 0 1 1.415-1.415zM18.5 8h-13a1.5 1.5 0 0 0-1.493 1.356L4 9.5v8a1.5 1.5 0 0 0 1.356 1.493L5.5 19h13a1.5 1.5 0 0 0 1.493-1.356L20 17.5v-8A1.5 1.5 0 0 0 18.5 8zM8 11a1 1 0 0 1 1 1v2a1 1 0 0 1-2 0v-2a1 1 0 0 1 1-1zm8 0a1 1 0 0 1 1 1v2a1 1 0 0 1-2 0v-2a1 1 0 0 1 1-1z",
  },
];
---

<footer class="border-t border-subtle bg-surface-sunken">
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-16 sm:px-6 lg:px-8 lg:pt-20">
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-8">
      <div class="max-w-sm space-y-6">
        <img
          alt="Cerulean Aviation Network"
          src="/logo.png"
          class="h-10 w-auto"
        />
        <p class="text-sm leading-6 text-muted">{t("tagline")}</p>
        <div class="flex gap-x-3">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex size-9 items-center justify-center rounded-control text-muted transition-colors hover:bg-surface-raised hover:text-airwaysn"
              >
                <span class="sr-only">{social.name}</span>
                <svg
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  class="size-5"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d={social.path}
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-2">
        {
          columns.map((column) => (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-faint">
                {column.title}
              </h3>
              {/* py-1.5 keeps these above a thumb-sized tap target on a
                  phone, where they are otherwise 17px tall. */}
              <ul role="list" class="mt-3 space-y-0.5">
                {column.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target={item.external ? "_blank" : undefined}
                      rel={item.external ? "noopener noreferrer" : undefined}
                      class="inline-block py-1.5 text-sm text-muted transition-colors hover:text-airwaysn"
                    >
                      {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-2 border-t border-subtle pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-faint">
        &copy; 2025 Cerulean Aviation Network. All rights reserved.
      </p>
      <p class="text-sm text-faint">
        Powered by <a
          href="https://jianyuelab.org"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block py-1 font-semibold text-muted transition-colors hover:text-airwaysn"
        >
          JianyueLab
        </a>
      </p>
    </div>
  </div>
</footer>
