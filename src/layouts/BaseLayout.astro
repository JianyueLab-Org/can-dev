---
import "@/styles/globals.css";
import ThemeLangControls from "@/components/ui/ThemeLangControls.vue";

interface Props {
  title: string;
}
const { title } = Astro.props;
const session = Astro.locals.session;
---

<!doctype html>
<html lang="zh-CN" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · CAN 开发者中心</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    {/* 主题在样式表之前定下来，否则深色模式的用户会先看到一帧白屏。 */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const dark =
          stored === "dark" ||
          (!stored && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-surface-sunken">
    <header class="border-b border-subtle bg-chrome">
      <div
        class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6"
      >
        <a href="/" class="-m-1.5 flex shrink-0 items-center gap-2.5 p-1.5">
          <img
            src="/logo.png"
            alt=""
            class="h-8 w-auto"
            width="32"
            height="32"
          />
          <span class="font-semibold text-ink">CAN 开发者中心</span>
        </a>
        <nav class="flex items-center gap-3 text-sm">
          {
            /*
            主题切换：这个站一直支持深色（globals.css 和那段无闪烁脚本都在），
            但从来没给过开关 —— 跟随系统而无法覆盖，等于一个关不掉的深色模式。
            语言那半关掉：开发者中心通篇中文，一个每项都跳回原页的选择器比没有
            更糟，它看着像坏了而不像没有。
          */
          }
          <ThemeLangControls client:load locale="zh-cn" :languages={false} />
          {
            session ? (
              <>
                <a class="text-muted hover:text-ink" href="/apps">
                  我的应用
                </a>
                <span class="text-faint">
                  {session.name ?? session.username}
                </span>
                <form method="POST" action="/auth/logout">
                  <button
                    class="btn btn-ghost px-3 py-1.5 text-xs"
                    type="submit"
                  >
                    退出
                  </button>
                </form>
              </>
            ) : (
              <a class="btn px-3 py-1.5 text-xs" href="/auth/login">
                用 CAN 账号登录
              </a>
            )
          }
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 pb-10 text-xs text-faint sm:px-6">
      <p>
        Cerulean Aviation Network · 接入说明见
        <a class="link" href="https://airwaysn.org/developers"
          >airwaysn.org/developers</a
        >
      </p>
    </footer>
  </body>
</html>
