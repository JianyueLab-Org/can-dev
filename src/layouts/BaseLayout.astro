---
/**
 * 页面外框。三个站现在是同一份形状 —— `<head>` 的声明逐字相同，主题脚本是同
 * 一个组件，浮动控件的开关走同一个 `floatingControls` prop。
 *
 * 这个文件原来还兼着站头和页脚，于是它既是外框又是导航；两件事拆开之后，渲染
 * `Header` 的页面把 `floatingControls` 设成 false（控件已经在站头里了），只有
 * 没有外壳的页面才落到右下角那颗浮动药丸上。can-web 和 can-radar 都是这个规
 * 矩，写在这里是为了让第三个站不要自己再发明一次。
 */
import "@/styles/globals.css";
import ThemeScript from "@jianyuelab-org/can-ui/components/ThemeScript.astro";
import { ThemeLangControls } from "@jianyuelab-org/can-ui";
import { getLocale, useTranslations } from "@/lib/i18n";

interface Props {
  /** 页面标题，会拼上站名。整串自己定的话传 `titleOverride`。 */
  title?: string;
  description?: string;
  floatingControls?: boolean;
}

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "dev");

const {
  title,
  description = t("tagline"),
  floatingControls = true,
} = Astro.props;

const fullTitle = title ? `${title} · ${t("siteName")}` : t("siteName");
---

<!doctype html>
<html lang={locale} class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4c92c1" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {
      /* 方形标记，不是 logo-full.png —— 那张图上写的是网络的旧名字
        "Cerulean Aviation Network"，而分享卡片是这个站露脸最多的地方。 */
    }
    <meta property="og:image" content="/icon-512.png" />
    <ThemeScript />
  </head>
  <body class="min-h-dvh bg-surface-sunken">
    <slot />
    {
      floatingControls && (
        <ThemeLangControls locale={locale} variant="floating" client:idle />
      )
    }
  </body>
</html>
