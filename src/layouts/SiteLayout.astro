---
/**
 * 外壳 + 正文。页面不写 `<main>`：`CanFrame` 渲染它、跳转链接和页脚。
 *
 * `pathname` 用 `Astro.originPathname`：中间件把非开发者改写到 `/no-access`
 * 时，导航仍标出他请求的那一页。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/Frame.vue";
import { getLocale, getMessages } from "@/lib/i18n";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const locale = getLocale(Astro.cookies);
const session = Astro.locals.session;

const frameMessages = {
  ...getMessages(locale, "frame"),
  nav: getMessages(locale, "dev.nav"),
};

const user = session
  ? {
      name: session.name ?? session.username,
      id: session.username,
      rating: session.rating,
    }
  : null;
---

<BaseLayout title={title} description={description} floatingControls={false}>
  <Frame
    messages={frameMessages}
    locale={locale}
    pathname={Astro.originPathname}
    user={user}
    signInHref={`/auth/login?next=${encodeURIComponent(Astro.originPathname)}`}
    client:load
  >
    <div class="page-sunken page-gutter w-full py-10">
      <slot />
    </div>
  </Frame>
</BaseLayout>
