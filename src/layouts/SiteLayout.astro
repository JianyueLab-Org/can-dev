---
/**
 * 外壳 + 正文。页面不写 `<main>`：`CanFrame` 渲染它、跳转链接和页脚。
 *
 * `pathname` 用 `Astro.originPathname`：中间件把非开发者改写到 `/no-access`
 * 时，导航仍标出他请求的那一页。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Frame from "@/components/Frame.vue";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";

interface Props {
  title?: string;
  description?: string;
  /** 正文容器的宽度。文档页要更宽的一档来放侧边目录。 */
  width?: "narrow" | "wide";
}

const { title, description, width = "narrow" } = Astro.props;

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "dev");
const session = Astro.locals.session;

const frameMessages = {
  ...getMessages(locale, "frame"),
  nav: getMessages(locale, "dev.nav"),
  siteName: t("siteName"),
};

const user = session
  ? {
      name: session.name ?? session.username,
      id: session.username,
      rating: session.rating,
    }
  : null;

const mainWidth = width === "wide" ? "max-w-7xl" : "max-w-5xl";
---

<BaseLayout
  title={title}
  description={description}
  floatingControls={false}
  narrow={width !== "wide"}
>
  <Frame
    messages={frameMessages}
    locale={locale}
    pathname={Astro.originPathname}
    user={user}
    signInHref={`/auth/login?next=${encodeURIComponent(Astro.originPathname)}`}
    client:load
  >
    <div
      class={`page-sunken mx-auto w-full px-4 py-10 sm:px-6 lg:px-8 ${mainWidth}`}
    >
      <slot />
    </div>
  </Frame>
</BaseLayout>
