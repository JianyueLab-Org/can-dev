---
import BaseLayout from "@/layouts/BaseLayout.astro";

const session = Astro.locals.session;
const error = Astro.url.searchParams.get("error");

/** 登录路上出的错，翻成人话。未知的原样显示，总比一句「出错了」有用。 */
const ERRORS: Record<string, string> = {
  missing_state: "登录请求已经过期了，重新点一次。",
  state_mismatch: "这次登录的来源对不上，出于安全考虑没有继续。重新点一次。",
  exchange_failed: "没能从 airwaysn.org 换到令牌，稍后再试。",
  access_denied: "你在授权页上点了拒绝。",
};
---

<BaseLayout title="首页">
  {
    error && (
      <div class="card mb-6 border-red-300 bg-red-50 text-sm text-red-900">
        {ERRORS[error] ?? `登录失败：${error}`}
      </div>
    )
  }

  <h1 class="text-2xl font-semibold text-ink">把 CAN 账号接进你的应用</h1>
  <p class="mt-3 max-w-2xl text-muted">
    Cerulean Aviation Network 是一个标准的 OAuth 2.1 / OpenID Connect
    身份提供方。成员用自己的 ASN 账号登录你的应用，你拿到的是一枚令牌，而不是
    他的密码。在这里注册应用、管理回调地址和密钥。
  </p>

  <div class="mt-8 flex flex-wrap gap-3">
    {
      session ? (
        <a class="btn" href="/apps">
          管理我的应用
        </a>
      ) : (
        <a class="btn" href="/auth/login">
          用 CAN 账号登录
        </a>
      )
    }
    <a class="btn btn-ghost" href="https://airwaysn.org/developers">
      接口文档
    </a>
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-3">
    <div class="card">
      <h2 class="font-medium text-ink">强制 PKCE</h2>
      <p class="mt-2 text-sm text-muted">
        所有客户端一律 S256，机密客户端也不例外 ——
        授权码要经过浏览器地址栏，密钥在那里保护不了任何东西。
      </p>
    </div>
    <div class="card">
      <h2 class="font-medium text-ink">回调地址精确匹配</h2>
      <p class="mt-2 text-sm text-muted">
        没有通配、没有前缀匹配。唯一的例外是 RFC 8252 的环回地址，只忽略端口，
        给桌面端用。
      </p>
    </div>
    <div class="card">
      <h2 class="font-medium text-ink">令牌可即时撤销</h2>
      <p class="mt-2 text-sm text-muted">
        access 令牌是不透明的，每次使用都查库。成员在
        <span class="whitespace-nowrap">「已授权应用」</span>
        里一按，下一个请求就失效。
      </p>
    </div>
  </div>
</BaseLayout>
