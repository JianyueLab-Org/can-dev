---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { AlertBox } from "@jianyuelab-org/can-ui";
import { getLocale, useTranslations } from "@/lib/i18n";

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "dev");

const session = Astro.locals.session;
const error = Astro.url.searchParams.get("error");

/**
 * 登录路上出的错，翻成人话。
 *
 * 未知的原样带上 `error` 显示 —— 一句「出错了」什么也不说，而这些值来自
 * OAuth 规范，写出来至少能被搜到。
 */
const KNOWN_ERRORS = new Set([
  "missing_state",
  "state_mismatch",
  "exchange_failed",
  "access_denied",
]);

const errorText = error
  ? KNOWN_ERRORS.has(error)
    ? t(`home.errors.${error}`)
    : t("home.errors.unknown", { error })
  : null;

const features = ["pkce", "redirect", "revoke"] as const;
---

<SiteLayout title={t("home.eyebrow")}>
  {
    errorText && (
      <div class="mb-8">
        <AlertBox variant="danger">{errorText}</AlertBox>
      </div>
    )
  }

  <section class="card overflow-hidden">
    <div class="relative isolate px-6 py-10 sm:px-10 sm:py-12">
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-gradient-to-br from-can-50 to-transparent dark:from-can-900/40"
      >
      </div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-can">
        {t("home.eyebrow")}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        {t("home.title")}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">{t("home.description")}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        {
          session ? (
            <a class="btn btn-primary" href="/apps">
              {t("home.manageApps")}
            </a>
          ) : (
            <a class="btn btn-primary" href="/auth/login">
              {t("auth.signIn")}
            </a>
          )
        }
        <a class="btn btn-ghost" href="/docs">{t("home.readDocs")}</a>
      </div>
    </div>
  </section>

  <div class="stagger mt-8 grid gap-4 sm:grid-cols-3">
    {
      features.map((key) => (
        <div class="card animate-fade-up p-6">
          <h2 class="font-semibold text-ink">
            {t(`home.features.${key}.title`)}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            {t(`home.features.${key}.detail`)}
          </p>
        </div>
      ))
    }
  </div>
</SiteLayout>
