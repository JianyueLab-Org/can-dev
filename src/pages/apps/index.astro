---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { AlertBox, EmptyState, PageHeader } from "@jianyuelab-org/can-ui";
import AppManager from "@/components/AppManager.vue";
import { listClients } from "@/lib/canApi";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";

/**
 * 「我的应用」。
 *
 * 首屏的数据在服务端取好、当 prop 交给岛屿，而不是让岛屿挂载后自己再拉一次
 * —— 后者会让页面先闪一下空列表。之后的增删改由岛屿走 /api/clients/*。
 *
 * 中间件保证到这里一定有会话（/apps 在 `PROTECTED_PREFIXES` 里）。
 */
const session = Astro.locals.session!;

/**
 * `listClients` 只在 can-api 根本连不上（网络断了、超时）时抛。那不是会话的
 * 问题，叫人重新登录也没用：这里接住它，换一句「稍后再试」和一个重试链接，
 * 而不是一个 500 页。can-api 答了话的失败（401 也在内）不经过这里，照旧走下
 * 面那条「重新登录」。
 */
let result: Awaited<ReturnType<typeof listClients>> | null = null;
try {
  result = await listClients(session.accessToken);
} catch (error) {
  console.error("apps: can-api unreachable", error);
  Astro.response.status = 503;
}

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "dev");

/**
 * 权限清单的**名字**写在这里，文案在词典里。
 *
 * 这份文案是给注册者读的（「你要申请什么」），can-web 字典里那份是给成员读的
 * （「你要授予什么」）—— 同一个 scope，两种人称。真正防止两边漂移的不是文案
 * 而是 can-api 的 `SelfServiceScopes`：这里多列一个，它也不会通过。
 */
const SCOPE_NAMES = [
  "openid",
  "profile",
  "email",
  "divisions",
  "flights:read",
  "atc:read",
  "offline_access",
] as const;

const scopes = SCOPE_NAMES.map((name) => ({
  name,
  title: t(`scopes.${name}.title`),
  detail: t(`scopes.${name}.detail`),
}));
---

<SiteLayout title={t("apps.title")}>
  <PageHeader title={t("apps.title")}>
    <span slot="description" class="block max-w-3xl">
      {t("apps.description")}
    </span>
  </PageHeader>

  {
    result === null ? (
      <div class="card">
        <EmptyState
          icon="cloud"
          title={t("apps.unreachable.title")}
          description={t("apps.unreachable.description")}
        >
          <a slot="action" class="btn btn-secondary" href="/apps">
            {t("apps.unreachable.retry")}
          </a>
        </EmptyState>
      </div>
    ) : result.ok ? (
      <AppManager
        client:load
        initial={result.data}
        scopes={scopes}
        messages={getMessages(locale, "dev.apps")}
      />
    ) : (
      <AlertBox
        variant="danger"
        title={t("apps.loadFailed", { message: result.message })}
      >
        <p>
          {t("apps.loadFailedHint")}{" "}
          <a class="link font-semibold" href="/auth/login">
            {t("apps.signInAgain")}
          </a>
        </p>
      </AlertBox>
    )
  }
</SiteLayout>
