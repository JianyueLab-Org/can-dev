---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { NoAccess, originsFromEnv } from "@jianyuelab-org/can-ui";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { webOrigin } from "@/lib/config";

/**
 * 「这个账号还不是开发者」，403。
 *
 * 只经中间件改写到达：`/apps`、`/docs` 上已登录但不是开发者的请求，地址不变。
 * 直接访问这个地址跳回首页。
 *
 * 不提供「申请」按钮：授权是 ADM 在 can-portal 上一个人一个人发的。
 */
const session = Astro.locals.session;
if (!Astro.locals.noAccess || !session) {
  return Astro.redirect("/", 302);
}
Astro.response.status = 403;

const locale = getLocale(Astro.cookies);
const t = useTranslations(locale, "dev");
const frame = useTranslations(locale, "frame");
const steps = ["who", "ask", "then"] as const;
const supportUrl = `${webOrigin()}/support`;
---

<SiteLayout title={frame("noAccess.title")} description={t("noAccess.summary")}>
  <NoAccess
    reason={{ kind: "permission", name: t("noAccess.permissionName") }}
    userName={session.name ?? session.username}
    userId={session.username}
    current="dev"
    locale={locale}
    rating={session.rating}
    messages={getMessages(locale, "frame")}
    origins={originsFromEnv(import.meta.env)}
  >
    <div slot="next-steps" class="flex flex-col gap-6">
      <p class="text-sm leading-relaxed text-muted">
        {t("noAccess.summary")}
      </p>
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">
          {t("noAccess.howTitle")}
        </h2>
        <ol role="list" class="mt-4 space-y-4">
          {
            steps.map((step, index) => (
              <li class="card flex gap-4 p-5">
                <span
                  aria-hidden="true"
                  class="flex size-7 shrink-0 items-center justify-center rounded-full bg-surface-sunken font-mono text-sm font-semibold text-ink"
                >
                  {index + 1}
                </span>
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-ink">
                    {t(`noAccess.steps.${step}.title`)}
                  </p>
                  <p class="mt-1 text-sm leading-relaxed text-muted">
                    {t(`noAccess.steps.${step}.detail`)}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a class="btn btn-primary px-5 py-2.5" href={supportUrl}>
          {t("noAccess.contact")}
        </a>
        <a class="btn btn-ghost px-5 py-2.5" href="/ground">
          {t("noAccess.ground")}
        </a>
      </div>
    </div>
  </NoAccess>
</SiteLayout>
