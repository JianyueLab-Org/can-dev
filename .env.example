# 开发者中心自己是 can-web 上的一个 OAuth 应用。它是**机密客户端**（有后端，
# 存得住密钥），并且必须由 scripts/oauth-client.mjs 手工注册 —— 它要的
# apps:manage 不在自助注册的名单里。注册命令见 README。
CAN_ISSUER=https://airwaysn.org
CAN_CLIENT_ID=can-dev
CAN_CLIENT_SECRET=

# 这个部署自己的对外地址。回调地址是 <PUBLIC_ORIGIN>/auth/callback，
# 且必须和注册时填的一字不差 —— can-web 那边是整串精确匹配。
PUBLIC_ORIGIN=http://127.0.0.1:4322

# 会话 cookie 的加密密钥。32 字节以上的随机串：openssl rand -base64 32
SESSION_SECRET=
